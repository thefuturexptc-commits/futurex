rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    function isSuperAdminEmail() {
      return signedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email == 'thefuturex.ptc@gmail.com';
    }

    // Product catalog
    // Public read keeps storefront working.
    // If you need strict admin-only reads for variant/size stock, change read to: allow read: if isAdmin();
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSuperAdminEmail();
    }

    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || isSuperAdminEmail();
    }

    match /product_notify_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || isSuperAdminEmail();
    }

    // Settings & categories are admin-managed.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdminEmail();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdminEmail();
    }

    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdminEmail();
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin() || isSuperAdminEmail();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'Processing';
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isSuperAdminEmail());
      allow update, delete: if isAdmin() || isSuperAdminEmail();
    }

    match /support_chats/{chatId} {
      allow create: if signedIn();
      allow read, update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /site_analytics/{eventId} {
      allow create: if !(isAdmin() || isSuperAdminEmail()) &&
        !request.resource.data.pagePath.matches('^/admin(/.*|[?].*|$)');
      allow read, update, delete: if isAdmin() || isSuperAdminEmail();
    }

    match /analytics_excluded_sessions/{sessionId} {
      allow read, write: if isAdmin() || isSuperAdminEmail();
    }

    match /offer_leads/{leadId} {
      allow create: if request.resource.data.phone is string && request.resource.data.phone.size() <= 20;
      allow read, update, delete: if isAdmin() || isSuperAdminEmail();
    }

    match /recovery_carts/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.userId == userId && request.resource.data.consent is bool &&
        request.resource.data.items is list && request.resource.data.items.size() <= 50 &&
        request.resource.data.keys().hasOnly(['userId', 'consent', 'consentAt', 'items', 'updatedAt', 'completed']);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth.uid == userId || isAdmin();
    }
  }
}
