{
  "trailingSlash": false,
  "functions": {
    "api/product-page.js": {
      "includeFiles": "dist/{product-shell.html,_catalog/**,product/**}"
    },
    "api/sitemap.js": {
      "includeFiles": "dist/_catalog/server/**"
    }
  },
  "headers": [
    {
      "source": "/product-shell.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/_catalog/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/product-feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, s-maxage=900"
        }
      ]
    },
    {
      "source": "/product-feed.csv",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/csv; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, s-maxage=900"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/:path((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/terms-and-conditions",
      "destination": "https://thefuturex.in/info/terms",
      "statusCode": 301
    },
    {
      "source": "/refund_returns",
      "destination": "https://thefuturex.in/info/returns-refund",
      "statusCode": 301
    },
    {
      "source": "/privacy-policy",
      "destination": "https://thefuturex.in/info/privacy",
      "statusCode": 301
    },
    {
      "source": "/index.php/2023/01/14/hello-world",
      "destination": "https://thefuturex.in/blog",
      "statusCode": 301
    },
    {
      "source": "/smart-glasses",
      "destination": "https://thefuturex.in/shop/all",
      "statusCode": 301
    },
    {
      "source": "/product/tfx-ai-smart-glasses",
      "destination": "https://thefuturex.in/shop/all",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.thefuturex.in"
        }
      ],
      "destination": "https://thefuturex.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.thefuturex.in"
        }
      ],
      "destination": "https://thefuturex.in/:path*",
      "permanent": true
    },
    {
      "source": "/product/the-future-x-tp-09-pro-heating-cooling-air-safe-for-kids-pets",
      "destination": "/product/tfxhot-and-coolair-pro",
      "statusCode": 301
    },
    {
      "source": "/product/ai-v5-smart-health-band-get-advanced-fitness-and-health-monitoring-with-the-future-x",
      "destination": "/product/tfx5-ai-smart-band",
      "statusCode": 301
    },
    {
      "source": "/product/tfx-display-pro-smart-ring-premium-tracking-with-display-and-wireless-charging",
      "destination": "/product/tfx-display-pro-smart-ring",
      "statusCode": 301
    },
    {
      "source": "/product-category/smart-bracelet",
      "destination": "/smart-bands",
      "statusCode": 301
    },
    {
      "source": "/product-category/smart-band",
      "destination": "/smart-bands",
      "statusCode": 301
    },
    {
      "source": "/product-category/smart-bands",
      "destination": "/smart-bands",
      "statusCode": 301
    },
    {
      "source": "/product-category/smart-ring",
      "destination": "/smart-rings",
      "statusCode": 301
    },
    {
      "source": "/product-category/smart-rings",
      "destination": "/smart-rings",
      "statusCode": 301
    },
    {
      "source": "/product-category/smart-fan",
      "destination": "/bladeless-fan",
      "statusCode": 301
    },
    {
      "source": "/product-category/smart-fans",
      "destination": "/bladeless-fan",
      "statusCode": 301
    },
    {
      "source": "/product-category/monitor",
      "destination": "/smart-monitoring",
      "statusCode": 301
    },
    {
      "source": "/product-category/smart-monitoring",
      "destination": "/smart-monitoring",
      "statusCode": 301
    },
    {
      "source": "/shop/:category/:slug",
      "destination": "/product/:slug",
      "statusCode": 301
    },
    {
      "source": "/product-feed",
      "destination": "/product-feed.xml",
      "statusCode": 301
    },
    {
      "source": "/merchant-feed",
      "destination": "/product-feed.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/product-reviews.xml",
      "destination": "/api/product-reviews"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page_id",
          "value": "5"
        }
      ],
      "destination": "/api/legacy-page"
    },
    {
      "source": "/index.php",
      "has": [
        {
          "type": "query",
          "key": "page_id",
          "value": "5"
        }
      ],
      "destination": "/api/legacy-page"
    },
    {
      "source": "/products/:id",
      "destination": "/api/legacy-product?id=:id"
    },
    {
      "source": "/item/:id",
      "destination": "/api/legacy-product?id=:id"
    },
    {
      "source": "/product-feed.xml",
      "destination": "/api/merchant-feed"
    },
    {
      "source": "/product-feed.csv",
      "destination": "/api/merchant-feed?format=csv"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/merchant-feed.xml",
      "destination": "/api/merchant-feed"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/product/:slug/:color",
      "destination": "/api/product-page?slug=:slug&variant=:color"
    },
    {
      "source": "/product/:slug",
      "destination": "/api/product-page?slug=:slug"
    },
    {
      "source": "/smart-bands",
      "destination": "/api/product-page?category=smart-bands"
    },
    {
      "source": "/smart-rings",
      "destination": "/api/product-page?category=smart-rings"
    },
    {
      "source": "/bladeless-fan",
      "destination": "/api/product-page?category=bladeless-fan"
    },
    {
      "source": "/smart-monitoring",
      "destination": "/api/product-page?category=smart-monitoring"
    },
    {
      "source": "/shop/all",
      "destination": "/api/product-page?category=shop/all"
    },
    {
      "source": "/shop",
      "destination": "/api/product-page?category=shop/all"
    },
    {
      "source": "/shop/:collection",
      "destination": "/api/product-page?collection=:collection"
    },
    {
      "source": "/register-warranty",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/edit-product",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/blog/bladeless-tower-fan-:page(guide|in-bengaluru|in-pune|in-varanasi|in-unnao|in-malappuram|in-falakata)",
      "destination": "/blog/bladeless-tower-fan-:page.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/blogs/:slug",
      "destination": "/index.html"
    }
  ]
}
