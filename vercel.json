{
  "trailingSlash": false,
  "functions": {
    "api/product-page.js": {
      "includeFiles": "dist/product-shell.html"
    }
  },
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/product-feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, s-maxage=900"
        }
      ]
    },
    {
      "source": "/product-feed.csv",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/csv; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, s-maxage=900"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/:path((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/terms-and-conditions/",
      "destination": "https://thefuturex.in/info/terms",
      "statusCode": 301
    },
    {
      "source": "/refund_returns/",
      "destination": "https://thefuturex.in/info/returns-refund",
      "statusCode": 301
    },
    {
      "source": "/privacy-policy/",
      "destination": "https://thefuturex.in/info/privacy",
      "statusCode": 301
    },
    {
      "source": "/index.php/2023/01/14/hello-world/",
      "destination": "https://thefuturex.in/blog",
      "statusCode": 301
    },
    {
      "source": "/smart-glasses",
      "destination": "https://thefuturex.in/shop/all",
      "statusCode": 301
    },
    {
      "source": "/product/tfx-ai-smart-glasses",
      "destination": "https://thefuturex.in/shop/all",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page_id", "value": "5" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.thefuturex.in" }],
      "destination": "https://thefuturex.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.thefuturex.in" }],
      "destination": "https://thefuturex.in/:path*",
      "permanent": true
    },
    {
      "source": "/product/the-future-x-tp-09-pro-heating-cooling-air-safe-for-kids-pets",
      "destination": "/product/tfxhot-and-coolair-pro",
      "permanent": true
    },
    {
      "source": "/product/ai-v5-smart-health-band-get-advanced-fitness-and-health-monitoring-with-the-future-x",
      "destination": "/product/tfx5-ai-smart-band",
      "permanent": true
    },
    {
      "source": "/product/tfx-display-pro-smart-ring-premium-tracking-with-display-and-wireless-charging",
      "destination": "/product/tfx-display-pro-smart-ring",
      "permanent": true
    },
    {
      "source": "/product-category/smart-bracelet",
      "destination": "/smart-bands",
      "permanent": true
    },
    {
      "source": "/product-category/smart-band",
      "destination": "/smart-bands",
      "permanent": true
    },
    {
      "source": "/product-category/smart-bands",
      "destination": "/smart-bands",
      "permanent": true
    },
    {
      "source": "/product-category/smart-ring",
      "destination": "/smart-rings",
      "permanent": true
    },
    {
      "source": "/product-category/smart-rings",
      "destination": "/smart-rings",
      "permanent": true
    },
    {
      "source": "/product-category/smart-fan",
      "destination": "/bladeless-fan",
      "permanent": true
    },
    {
      "source": "/product-category/smart-fans",
      "destination": "/bladeless-fan",
      "permanent": true
    },
    {
      "source": "/product-category/monitor",
      "destination": "/smart-monitoring",
      "permanent": true
    },
    {
      "source": "/product-category/smart-monitoring",
      "destination": "/smart-monitoring",
      "permanent": true
    },
    {
      "source": "/shop/:category/:slug",
      "destination": "/product/:slug",
      "permanent": true
    },
    {
      "source": "/product-feed",
      "destination": "/product-feed.xml",
      "permanent": true
    },
    {
      "source": "/merchant-feed",
      "destination": "/product-feed.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/products/:id",
      "destination": "/api/legacy-product?id=:id"
    },
    {
      "source": "/item/:id",
      "destination": "/api/legacy-product?id=:id"
    },
    {
      "source": "/product-feed.xml",
      "destination": "/api/merchant-feed"
    },
    {
      "source": "/product-feed.csv",
      "destination": "/api/merchant-feed?format=csv"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/merchant-feed.xml",
      "destination": "/api/merchant-feed"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/product/:slug",
      "destination": "/api/product-page?slug=:slug"
    },
    {
      "source": "/smart-bands",
      "destination": "/smart-bands/index.html"
    },
    {
      "source": "/smart-rings",
      "destination": "/smart-rings/index.html"
    },
    {
      "source": "/bladeless-fan",
      "destination": "/bladeless-fan/index.html"
    },
    {
      "source": "/smart-monitoring",
      "destination": "/smart-monitoring/index.html"
    },
    {
      "source": "/shop/all",
      "destination": "/shop/all/index.html"
    },
    {
      "source": "/shop",
      "destination": "/shop/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/edit-product",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/blogs/:slug",
      "destination": "/index.html"
    }
  ]
}
