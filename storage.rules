rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // Product images and videos are public storefront assets. Only an
    // authenticated administrator may upload, replace, or delete them.
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('^(image|video)/.*');
      allow delete: if isAdmin();
    }
  }
}
